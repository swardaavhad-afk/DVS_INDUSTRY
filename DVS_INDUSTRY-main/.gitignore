# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Vite cache ────────────────────────────────────────────────────
.vite/

# ── Environment files (never commit secrets) ──────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build info ─────────────────────────────────────────
*.tsbuildinfo

# ── Test coverage ─────────────────────────────────────────────────
coverage/

# ── OS artifacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Prisma generated client (regenerated via prisma generate) ─────
generated/prisma/

# ── Root-level lock file (not a workspace root package) ───────────
package-lock.json
