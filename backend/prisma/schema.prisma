generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────
// Authentication & Authorization
// ───────────────────────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id        Int       @id @default(autoincrement())
  fullName  String
  email     String    @unique
  password  String
  phone     String?
  roleId    Int
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]

  // One-to-One Employee Profile
  employee Employee?

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ───────────────────────────────────────────────────────────────
// Workforce
// ───────────────────────────────────────────────────────────────

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  managerId   Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees Employee[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model Shift {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  startTime    String
  endTime      String
  isNightShift Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id Int @id @default(autoincrement())

  // Identity
  employeeCode String  @unique
  firstName    String
  lastName     String
  email        String? @unique
  phone        String?
  gender       Gender?

  dateOfBirth DateTime?
  joiningDate DateTime

  // Employment
  designation    String
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @db.Decimal(10, 2)

  // Department
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Shift
  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Reporting Manager
  managerId Int?
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id])

  subordinates Employee[] @relation("EmployeeManager")

  // ERP Login
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Status
  status EmployeeStatus @default(ACTIVE)

  profileImage String?

  // Address
  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  // Emergency Contact
  emergencyName  String?
  emergencyPhone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attendances Attendance[]

  @@index([employeeCode])
  @@index([email])
  @@index([departmentId])
  @@index([managerId])
  @@index([shiftId])
  @@index([status])
}

model Attendance {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime

  clockIn  DateTime?
  clockOut DateTime?

  workingHours Float?

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
}

// ───────────────────────────────────────────────────────────────
// Inventory
// ───────────────────────────────────────────────────────────────

model Material {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  unit        String
  category    String?
  location    String?

  currentStock  Decimal @default(0) @db.Decimal(12, 3)
  minStockLevel Decimal @default(0) @db.Decimal(12, 3)
  maxStockLevel Decimal? @db.Decimal(12, 3)

  costPerUnit Decimal? @db.Decimal(12, 2)
  currency    String   @default("INR")

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions StockTransaction[]
  scrapRecords ScrapRecord[]

  @@index([code])
  @@index([isActive])
  @@index([category])
  @@index([currentStock])
}

model StockTransaction {
  id           Int                  @id @default(autoincrement())
  materialId   Int
  material     Material             @relation(fields: [materialId], references: [id])

  type         StockTransactionType
  quantity     Decimal              @db.Decimal(12, 3)
  balanceAfter Decimal              @db.Decimal(12, 3)

  referenceNo     String?
  reason          String?
  performedById   Int?
  performedByName String?
  departmentId    Int?
  departmentName  String?

  createdAt DateTime @default(now())

  @@index([materialId])
  @@index([type])
  @@index([createdAt])
  @@index([departmentId])
  @@index([referenceNo])
}

model ScrapRecord {
  id         Int      @id @default(autoincrement())
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  quantity      Decimal @db.Decimal(12, 3)
  unit          String
  departmentId  Int?
  departmentName String?
  employeeId    Int?
  employeeName  String?
  reason        String?
  recoveryValue Decimal? @db.Decimal(12, 2)

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([materialId])
  @@index([departmentId])
  @@index([recordedAt])
}

// ───────────────────────────────────────────────────────────────
// Orders
// ───────────────────────────────────────────────────────────────

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String  @default("India")
  gstin       String?
  rating      Decimal? @db.Decimal(3, 1)   // 0.0 – 5.0
  leadTimeDays Int?
  reliability  String?                      // "98%", "99%" etc.
  materials   String?                       // comma-separated material names
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([isActive])
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String  @default("India")
  gstin       String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientOrders ClientOrder[]

  @@index([code])
  @@index([isActive])
}

model ClientOrder {
  id           Int               @id @default(autoincrement())
  orderNumber  String            @unique            // e.g. ORD-2841
  clientId     Int
  client       Client            @relation(fields: [clientId], references: [id])

  product       String
  quantity      Int
  unit          String           @default("pcs")
  value         Decimal?         @db.Decimal(14, 2)
  currency      String           @default("INR")

  orderDate     DateTime         @default(now())
  requiredDate  DateTime?
  dispatchDate  DateTime?
  deliveryDate  DateTime?

  status        ClientOrderStatus @default(PENDING)

  notes         String?
  dispatchNote  String?
  challanNumber String?
  invoiceNumber String?

  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([orderDate])
  @@index([orderNumber])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique            // e.g. PO-2847
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id])

  material     String
  quantity     String                                 // e.g. "500 kg"
  unit         String?
  totalCost    Decimal?            @db.Decimal(14, 2)
  currency     String              @default("INR")

  orderDate     DateTime           @default(now())
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  status        PurchaseOrderStatus @default(PENDING)

  notes         String?
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([poNumber])
}

// ───────────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  LEAVE
}

enum StockTransactionType {
  IN          // Stock received / purchased
  OUT         // Consumed in production
  ADJUSTMENT  // Manual correction
  SCRAP       // Scrap write-off
  RETURN      // Returned to supplier / store
}

enum ClientOrderStatus {
  PENDING
  APPROVED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}
